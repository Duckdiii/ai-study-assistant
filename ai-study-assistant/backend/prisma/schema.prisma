generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====
enum UserRole {
  ADMIN
  USER
}

enum ProblemStatus {
  PENDING
  SOLVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AiType {
  SOLVE
  SUMMARIZE
  OTHER
}

// ===== Models =====

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String? // null nếu chỉ dùng OAuth
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems      Problem[]
  notes         Note[]
  messages      ChatMessage[]
  aiLogs        AiInteraction[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id             Int     @id @default(autoincrement())
  provider       String // "google"
  providerUserId String // sub từ Google
  accessToken    String?
  refreshToken   String?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([provider, providerUserId])
}

model Problem {
  id         Int           @id @default(autoincrement())
  title      String
  content    String // mô tả bài toán
  subject    String // "Math", "DSA", "Crypto", ...
  difficulty Difficulty    @default(MEDIUM)
  status     ProblemStatus @default(PENDING)

  owner   User @relation(fields: [ownerId], references: [id])
  ownerId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]
  files File[]

  aiInteractions AiInteraction[]
}

model Note {
  id      Int    @id @default(autoincrement())
  content String

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int
,
  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  createdAt DateTime @default(now())
}

model File {
  id       Int    @id @default(autoincrement())
  filename String // tên gốc
  path     String // đường dẫn lưu file
  mimeType String
  size     Int // byte

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int

  uploadedAt DateTime @default(now())
}

model ChatMessage {
  id      Int    @id @default(autoincrement())
  roomId  String // có thể là "global" hoặc "user-<id>"...
  content String

  sender   User @relation(fields: [senderId], references: [id])
  senderId Int

  createdAt DateTime @default(now())
}

model AiInteraction {
  id       Int    @id @default(autoincrement())
  type     String // "SOLVE" | "SUMMARIZE" | ...
  prompt   String
  response String

  user   User @relation(fields: [userId], references: [id])
  userId Int

  problem   Problem? @relation(fields: [problemId], references: [id])
  problemId Int?

  createdAt DateTime @default(now())
}
